#!/bin/sh
set -eu
printf 'omarchy %s\n' "$*" >> "$FAKE_LOG"
plugin_dir="$HOME/.config/omarchy/plugins/zerobearing.omatalk"
case "${1:-} ${2:-}" in
  "pkg present")
    shift 2
    for pkg in "$@"; do
      case " ${FAKE_PKG_ABSENT:-} " in
        *" $pkg "*)
          exit 1
          ;;
      esac
    done
    ;;
  "pkg add")
    exit "${FAKE_PKG_ADD_FAIL:-0}"
    ;;
  "plugin enable")
    if [ "${FAKE_PLUGIN_ENABLE_FAIL:-0}" = 1 ]; then
      exit 1
    fi
    touch "$FAKE_STATE/plugin-enabled"
    ;;
  "plugin list")
    if [ -f "$plugin_dir/manifest.json" ]; then
      enabled=false
      if [ -f "$FAKE_STATE/plugin-enabled" ]; then
        enabled=true
      fi
      printf '[{"id":"omarchy.clock","name":"Clock","kinds":["bar-widget"],"enabled":true},'
      printf '{"id":"zerobearing.omatalk","name":"Omatalk","kinds":["bar-widget"],"enabled":%s}]\n' "$enabled"
    else
      printf '[{"id":"omarchy.clock","name":"Clock","kinds":["bar-widget"],"enabled":true}]\n'
    fi
    ;;
esac
