#!/bin/sh
# Players are "name status" lines in $OMATALK_TEST_MEDIA_FILE.
# Pause and Play calls are logged and update the file.
players="$OMATALK_TEST_MEDIA_FILE"
shift
case "$*" in
  "--acquired --no-legend list")
    cut -d' ' -f1 "$players" 2>/dev/null ;;
  "get-property "*" PlaybackStatus")
    status=$(awk -v n="$2" '$1 == n {print $2}' "$players")
    [ -n "$status" ] || exit 1
    echo "s \"$status\"" ;;
  "call "*" Pause"|"call "*" Play")
    grep -q "^$2 " "$players" || exit 1
    echo "$5 $2" >> "$OMATALK_TEST_MEDIA_LOG"
    case "$5" in Pause) to=Paused ;; *) to=Playing ;; esac
    sed -i "s/^$2 .*/$2 $to/" "$players" ;;
  *) exit 1 ;;
esac
