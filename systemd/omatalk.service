[Unit]
Description=Omatalk daemon: local text-to-speech, model warm
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/omatalk daemon
Environment=OMATALK_MODELS=%h/.local/share/omatalk/models
Restart=always
RestartSec=500ms

[Install]
# Not default.target: at boot that starts the Daemon before uwsm imports
# WAYLAND_DISPLAY, and wl-paste then cannot read the Selection.
WantedBy=graphical-session.target
