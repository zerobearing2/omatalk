#!/bin/bash
# Invoked only by the package's Upgrade/PostTransaction ALPM hook. pacman has
# just replaced /usr/bin/omatalk, so every Daemon still running is on the old
# binary. Restart each one that runs, as its own user, never as pacman's root.
# A failed restart is reported and never fails the update.
set -u

if [ "$#" -ne 1 ]; then
  exit 2
fi
case $1 in
  omatalk) ;;
  *) exit 2 ;;
esac
unit="$1.service"

if ! accounts=$(getent passwd); then
  echo ":: Could not list accounts; running omatalk daemons were not restarted" >&2
  exit 0
fi
while IFS=: read -r account _ user_id _ _ user_home _; do
  if [[ $user_home != /* ]]; then
    continue
  fi
  runtime="/run/user/$user_id"
  # Offline users have no user manager, so no running Daemon to restart.
  if [[ ! -S $runtime/bus && ! -S $runtime/systemd/private ]]; then
    continue
  fi
  if ! runuser -u "$account" -- env \
      XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
      systemctl --user try-restart "$unit"; then
    echo ":: Could not restart $unit for $account; restart it with: systemctl --user restart $unit" >&2
  fi
done <<< "$accounts"
exit 0
